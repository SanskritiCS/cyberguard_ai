# Copy this file to .env and fill in real values.
# .env must NEVER be committed to version control.

# --- Google Gemini -----------------------------------------------------

# Get a key from https://aistudio.google.com/app/apikey

GEMINI_API_KEY=AQ.Ab8RN6I40DzFEhGKs6vgVqa7UBjReKkXjMC3UltHmbHhz7w2Kw
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=60

# --- Environment --------------------------------------------------------

# development | production

ENVIRONMENT=development

# --- CORS ---------------------------------------------------------------

# Comma-separated list of allowed origins.

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000

# --- Rate limiting (applies to /ask-ai only) ----------------------------

RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# --- Logging ------------------------------------------------------------

LOG_LEVEL=INFO